  m_Name: ReviewTemplateLibrarySO
  fiveStarTemplates:
  - "Qu\xE1n pha c\u1EF1c ngon! \u0110\u1EB7c bi\u1EC7t th\xEDch {praise}."
  - "H\u01B0\u01A1ng v\u1ECB chu\u1EA9n gu, kh\xF4ng gian \u1EA5m c\xFAng. \u0110i\u1EC3m 10 ch\u1EA5t l\u01B0\u1EE3ng!"
  - "10/10 kh\xF4ng c\xF3 nh\u01B0ng! Ch\u1EAFc ch\u1EAFn s\u1EBD d\u1EABn b\u1EA1n b\xE8 gh\xE9 l\u1EA1i qu\xE1n."
  fourStarTemplates:
  - "Kh\xE1 \u1ED5n \xE1p, \u0111\u1ED3 u\u1ED1ng v\u1EEBa mi\u1EC7ng. S\u1EBD quay l\u1EA1i."
  - "N\u01B0\u1EDBc ngon, ph\u1EE5c v\u1EE5 \u1ED5n, ch\u1EC9 c\u1EA7n ch\xFA \xFD {complaint} m\u1ED9t ch\xFAt l\xE0 ho\xE0n h\u1EA3o."
  threeStarTemplates:
  - "T\u1EA1m \u0111\u01B0\u1EE3c, tr\u1EA3i nghi\u1EC7m \u1EDF m\u1EE9c trung b\xECnh."
  - "U\u1ED1ng c\u0169ng \u0111\u01B0\u1EE3c nh\u01B0ng {complaint} c\u1EA7n c\u1EA3i thi\u1EC7n h\u01A1n."
  lowStarTemplates:
  - "Kh\xE1 th\u1EA5t v\u1ECDng, {complaint} t\u1EC7 qu\xE1!"
  - "Kh\xF4ng h\u1EE3p gu ch\xFAt n\xE0o, ch\u1EDD l\xE2u m\xE0 \u0111\u1ED3 u\u1ED1ng l\u1EA1i kh\xF4ng \u01B0ng \xFD."
  - "R\u1EA5t t\u1EC7, {complaint} l\xE0m m\xECnh m\u1EA5t h\u1EE9ng ho\xE0n to\xE0n. S\u1EBD kh\xF4ng gh\xE9 l\u1EA1i!"

